# Copy this file to src/backend/.env and fill in values as needed.
# NEVER commit the .env file — it is already in .gitignore.

# ── Application ─────────────────────────────────────────────────────
APP_PORT=8000
APP_ENV=development

# ── IBM watsonx.ai (optional — leave blank if not using) ────────────
# NEXORA does not currently require watsonx.ai for the core POC.
# If you integrate IBM watsonx.ai, fill in these values.
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# ── Notifications (optional) ────────────────────────────────────────
SLACK_WEBHOOK_URL=
