# Copy this file to src/backend/.env and fill in values as needed.
# NEVER commit the .env file - it is already in .gitignore.

# --- Application ---
APP_PORT=8000
APP_ENV=development

# --- IBM watsonx.ai (optional - leave blank to use local advisory engine) ---
# Required only for the AI Failure Advisor IBM integration.
# When not set, the local deterministic advisory engine is used instead.
# The UI clearly indicates which provider is active.
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# --- Notifications (optional) ---
SLACK_WEBHOOK_URL=
